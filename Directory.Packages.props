<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions listed here also apply to packages that come in transitively, so a vulnerable transitive package can be raised here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <RunesmithVersion>0.1.0</RunesmithVersion>
  </PropertyGroup>
  <ItemGroup Label="Runesmith">
    <PackageVersion Include="Runesmith.Sdk" Version="$(RunesmithVersion)" />
    <PackageVersion Include="Runesmith.Text" Version="$(RunesmithVersion)" />
    <PackageVersion Include="Runesmith.LanguageServices" Version="$(RunesmithVersion)" />
  </ItemGroup>
  <ItemGroup Label="User interface">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="HammerUI" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup Label="Composition">
    <!-- Plugins share these with Runesmith, so the whole family has one version. -->
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Convention" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Runtime" Version="10.0.12" />
    <PackageVersion Include="System.Composition.TypedParts" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
