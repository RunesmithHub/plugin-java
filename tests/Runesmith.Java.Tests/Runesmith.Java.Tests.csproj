<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Sdks\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runesmith.Java\Runesmith.Java.csproj" />
    <!-- The plugin leaves the host's libraries out of its output, since Runesmith provides them; the tests need their own copy. -->
    <PackageReference Include="Runesmith.Sdk" />
    <PackageReference Include="Runesmith.Text" />
    <PackageReference Include="Runesmith.LanguageServices" />
  </ItemGroup>
</Project>
