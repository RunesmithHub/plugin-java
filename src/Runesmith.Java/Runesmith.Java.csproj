<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Java support for Runesmith: the language, the Java analyzer, the Maven and Gradle build provider and the JDK provider.</Description>
    <!-- A plugin carries its own libraries in its folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Java.Contracts\Runesmith.Java.Contracts.csproj" />
    <!-- The analyzer and the Java syntax it reads ship with the plugin. -->
    <ProjectReference Include="..\Runesmith.Languages.Java\Runesmith.Languages.Java.csproj" />
    <!-- Runesmith supplies these when it loads the plugin, so none of them is copied next to it. -->
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
    <PackageReference Include="Runesmith.Text" ExcludeAssets="runtime" />
    <PackageReference Include="Runesmith.LanguageServices" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.Java.Tests" />
  </ItemGroup>
</Project>
